{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wuwa/export-manifest.schema.json",
  "title": "WuWa export manifest",
  "type": "object",
  "required": ["schemaVersion", "jobId", "gameVersion", "sourceObjectPath", "toolVersions", "files", "warnings"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "jobId": { "type": "string" },
    "gameVersion": { "type": "string" },
    "ueVersion": { "type": "string" },
    "sourceObjectPath": { "type": "string" },
    "unrealObjectPath": { "type": "string" },
    "toolVersions": { "type": "object", "additionalProperties": { "type": "string" } },
    "mesh": { "type": "object" },
    "skeleton": { "type": "object" },
    "materials": { "type": "array" },
    "textures": { "type": "array" },
    "animations": { "type": "array" },
    "materialParameters": { "type": "array" },
    "files": { "type": "array", "items": { "type": "string" } },
    "sourceHashes": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "golden": { "type": "object" }
  },
  "additionalProperties": true
}
